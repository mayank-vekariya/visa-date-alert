# Get these two values from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Include the country code in E.164 format. Used only during login.
TELEGRAM_PHONE=

# A separate BotFather bot sends normal notification messages to your account.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Start with this empty. Run `visa-alert list-chats`, then paste the desired IDs.
MONITORED_CHAT_IDS=

# Matching is case-insensitive. Add aliases separated by commas.
TARGET_VISAS=B1/B2,B1 B2,visitor visa,tourist visa,H1B,H-1B,H1,H4,Dropbox,Interview Waiver,IW
TARGET_LOCATIONS=Mumbai,Delhi,Hyderabad,Chennai,Kolkata,MUM,DEL,HYD,CHN,KOL

# Medium alerts go to Telegram Saved Messages. High alerts can also place a call.
MEDIUM_SCORE=5
HIGH_SCORE=9
ALERT_REPEAT_DELAYS=20,60
DEDUP_WINDOW_SECONDS=300

# Keep this false for normal use. When true, messages are scored but no alerts are sent.
DRY_RUN=false

# Optional Twilio settings. Leave blank until you want phone calls/SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=
# Hosted TwiML Bin URL is required by Twilio trial accounts.
TWILIO_TWIML_URL=
ENABLE_CALLS=false
ENABLE_SMS=false
