[Unit]
Description=Visa Date Alert Telegram monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/visa-date-alert
ExecStart=%h/visa-date-alert/.venv/bin/visa-alert run
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
